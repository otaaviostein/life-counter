{
  "expo": {
    "name": "Life Counter",
    "slug": "life-counter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifecounter",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0C08",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.otaviostein.lifecounter",
      "buildNumber": "1",
      "appleTeamId": "YVE9YEL486"
    },
    "android": {
      "package": "com.otaviostein.lifecounter",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0C08"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0C08"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
